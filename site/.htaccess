# Weiterleitungen: www auf capeeshee.com ohne www, alte WordPress-Adressen auf die neuen Seiten
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Alte WordPress-Seite unter /19/ und frühere Adressen
  RewriteRule ^19/datenschutz/?$ https://capeeshee.com/datenschutz/ [R=301,L,NC]
  RewriteRule ^19/impressum/?$ https://capeeshee.com/impressum/ [R=301,L,NC]
  RewriteRule ^19/(referenzen|portfolio|portfolio_cat)(/.*)?$ https://capeeshee.com/referenzen/ [R=301,L,NC]
  RewriteRule ^19/kontakt/?$ https://capeeshee.com/#kontakt [R=301,L,NC,NE]
  RewriteRule ^(19/)?new-marketing/?$ https://capeeshee.com/#leistungen [R=301,L,NC,NE]
  RewriteRule ^marketing/?$ https://capeeshee.com/#leistungen [R=301,L,NC,NE]
  RewriteRule ^(19/)?wordpress-agentur/?$ https://capeeshee.com/#leistungen [R=301,L,NC,NE]
  RewriteRule ^(impressum|datenschutz|referenzen)$ https://capeeshee.com/$1/ [R=301,L,NC]
  RewriteRule ^19(/.*)?$ https://capeeshee.com/ [R=301,L,NC]

  # www.capeeshee.com -> capeeshee.com (http -> https erledigt bereits STRATO)
  RewriteCond %{HTTP_HOST} ^www\.capeeshee\.com$ [NC]
  RewriteRule ^(.*)$ https://capeeshee.com/$1 [R=301,L]

</IfModule>

ErrorDocument 404 /404.html

# HTML immer frisch laden, Bilder/Schriften dürfen gecacht werden (werden per ?v= versioniert)
<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|woff2|css|js|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <Files "kontakt.php">
    Header set X-Robots-Tag "noindex"
  </Files>
</IfModule>
